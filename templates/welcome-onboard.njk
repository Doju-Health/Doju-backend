<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Welcome to DOJU</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .header {
        background: #a9f334;
        padding: 40px 20px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
      }

      .content {
        padding: 40px 30px;
        color: #333333;
        font-size: 16px;
        line-height: 24px;
      }

      .highlight {
        background: #f7f7f7;
        border-left: 4px solid #a9f334;
        padding: 16px;
        border-radius: 6px;
        margin: 24px 0;
        color: #444;
      }

      .footer {
        background: #f7f7f7;
        text-align: center;
        padding: 20px;
        font-size: 14px;
        color: #666666;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- HEADER -->
      <div class="header">
        <h1>Welcome to DOJU</h1>
      </div>

      <!-- BODY -->
      <div class="content">
        <p>Hi {{ fullName }},</p>

        <p>
          You are all set. Your email is verified and your DOJU account is ready.
          We are excited to help you buy and sell with confidence.
        </p>

        {% if role == 'seller' %}
        <div class="highlight">
          <strong>For sellers</strong>
          <div>Complete your profile, add your business details, and start listing products.</div>
        </div>
        {% else %}
        <div class="highlight">
          <strong>For buyers</strong>
          <div>Browse products, save items to your cart, and check out when you are ready.</div>
        </div>
        {% endif %}

        <p>
          Have feedback or need help? Just reply to this email and our team will get back to you.
        </p>

        <p>
          Thanks for joining us,<br />
          The DOJU Team
        </p>
      </div>

      <!-- FOOTER -->
      <div class="footer">
        You are receiving this email because you verified {{ email }} on DOJU.
        <br /><br />
        (c) 2026 DOJU
      </div>
    </div>
  </body>
</html>
