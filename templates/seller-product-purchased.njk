<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your Product Has Been Purchased</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        width: 100%;
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .header {
        background: #a9f334;
        padding: 40px 20px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
      }

      .content {
        padding: 40px 30px;
        color: #333333;
        font-size: 16px;
        line-height: 24px;
      }

      .highlight {
        background: #f7f7f7;
        border-left: 4px solid #a9f334;
        padding: 16px;
        border-radius: 6px;
        margin: 24px 0;
        color: #444;
      }

      .details {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 28px;
      }

      .details td {
        padding: 10px 0;
        vertical-align: top;
        border-bottom: 1px solid #eee;
        font-size: 14px;
      }

      .details td:first-child {
        color: #666666;
        width: 42%;
        padding-right: 16px;
      }

      .button {
        display: inline-block;
        background: #a9f334;
        color: #ffffff !important;
        text-decoration: none;
        padding: 14px 22px;
        border-radius: 6px;
        font-weight: bold;
        margin-top: 10px;
      }

      .footer {
        background: #f7f7f7;
        text-align: center;
        padding: 20px;
        font-size: 14px;
        color: #666666;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Your Product Has Been Purchased</h1>
      </div>

      <div class="content">
        <p>Hi {{ sellerName }},</p>

        <p>
          Congratulations! {{ buyerName }} from {{ buyerLocation }} wants to buy your {{ productName }}.
        </p>

        <div class="highlight">
          <strong>Purchase summary</strong>
          <table class="details">
            <tr>
              <td>Product</td>
              <td>{{ productName }}</td>
            </tr>
            <tr>
              <td>Buyer</td>
              <td>{{ buyerName }}</td>
            </tr>
            <tr>
              <td>Buyer location</td>
              <td>{{ buyerLocation }}</td>
            </tr>
            <tr>
              <td>Quantity</td>
              <td>{{ quantity }}</td>
            </tr>
            <tr>
              <td>Unit price</td>
              <td>{{ unitPrice }}</td>
            </tr>
            <tr>
              <td>Total paid</td>
              <td>{{ totalPaid }}</td>
            </tr>
            {% if deliveryFee %}
            <tr>
              <td>Delivery fee</td>
              <td>{{ deliveryFee }}</td>
            </tr>
            {% endif %}
            {% if pickupStore %}
            <tr>
              <td>Pickup Store</td>
              <td>{{ pickupStore }}</td>
            </tr>
            {% endif %}
            <tr>
              <td>Purchase time</td>
              <td>{{ purchaseTime }}</td>
            </tr>
            <tr>
              <td>Expected delivery</td>
              <td>{{ expectedDeliveryDate }}</td>
            </tr>
          </table>
        </div>

        <p>
          Best regards,<br />
          The DOJU Team
        </p>
      </div>

      <div class="footer">
        You are receiving this email because a buyer purchased {{ productName }} on DOJU.
        <br /><br />
        (c) 2026 DOJU
      </div>
    </div>
  </body>
</html>
