<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New application awaiting review</title>
    <style>
      body { margin: 0; padding: 0; background: #f5f5f5; font-family: Arial, Helvetica, sans-serif; }
      .container { width: 100%; max-width: 600px; margin: 40px auto; background: #fff; border-radius: 8px; overflow: hidden; }
      .header { background: #a9f334; padding: 32px 20px; text-align: center; color: #fff; }
      .content { padding: 32px 30px; color: #333; font-size: 16px; line-height: 24px; }
      .highlight { background: #f7f7f7; border-left: 4px solid #a9f334; padding: 16px; border-radius: 6px; margin: 24px 0; }
      .details { width: 100%; border-collapse: collapse; }
      .details td { padding: 9px 0; border-bottom: 1px solid #eee; font-size: 14px; vertical-align: top; overflow-wrap: anywhere; }
      .details td:first-child { color: #666; width: 38%; padding-right: 14px; }
      .button { display: inline-block; background: #a9f334; color: #fff !important; text-decoration: none; padding: 13px 20px; border-radius: 6px; font-weight: bold; }
      .footer { background: #f7f7f7; text-align: center; padding: 20px; font-size: 14px; color: #666; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header"><h1>Application Review Needed</h1></div>
      <div class="content">
        <p>Hi {{ adminName }},</p>
        <p>A new {{ applicationType }} application has been submitted and is awaiting review.</p>
        <div class="highlight">
          <strong>{{ applicationType }} application details</strong>
          <table class="details">
            {% for field in fields %}
            <tr><td>{{ field.label }}</td><td>{{ field.value }}</td></tr>
            {% endfor %}
          </table>
        </div>
        <p style="text-align: center;"><a class="button" href="{{ reviewUrl }}">Review Application</a></p>
        <p>Best regards,<br />The DOJU Team</p>
      </div>
      <div class="footer">You are receiving this email because you are an administrator on DOJU.<br /><br />(c) 2026 DOJU</div>
    </div>
  </body>
</html>
